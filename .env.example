# ============================================================
# CONTENT-KIT 专属环境配置 (源自主仓 .env.example 自动拆分)
# 生成时间: 2026-11-13 10:08:44
# 多级加载优先级：.env.local (子仓) > .env (子仓) > 主仓兜底底座
# ============================================================


# --- CNB 私有制品库配置 (通用令牌，分发至全部子仓) ---
# @tilo/api-client 等 CNB 私有制品拉取/发布的访问令牌
# 前端与 SDK 发布流水线统一消费：子仓 .npmrc (ohpm.cnb.cool 鉴权) 与 CI 流水线
# (imports: https://cnb.cool/tilo-work/keys/-/blob/main/default_keys.yml 导入同名变量)
TILO_REGISTRY_TOKEN=please_replace_with_cnb_package_access_token

# --- content-kit SDK 专属坐标（仅作用于 @tilo-ui/content-kit，不影响其他 SDK） ---
# CNB 上的 git 仓库与 npm 制品仓库不能同名：git 侧占用 tilo-content-kit，
# 故制品仓库改名为 tilo-npm-content-kit。改名/升版只改这两行，再执行：
#   bash scripts/sdk/sync-content-kit.sh
# 由脚本同步各前端仓的 .npmrc 与 package.json；发布与 CI 均从这两个变量派生 registry，
# 不要在 .npmrc / Dockerfile / .cnb.yml 里硬编码仓库名或版本。
CONTENT_KIT_NPM_REPO=tilo-npm-content-kit
CONTENT_KIT_VERSION=0.6.1
